{
	"name": "phpgt/cli",
	"description": "Command line interface builder.",
	"keywords": [
		"phpgt",
		"webengine",
		"cli",
		"terminal"
	],

	"require": {
		"php": ">=8.2",
		"ext-json": "*",
		"ext-readline": "*",
		"phpgt/daemon": "^1.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^1.10",
		"phpunit/phpunit": "^10.5",
		"phpmd/phpmd": "^2.13",
		"squizlabs/php_codesniffer": "^4.0"
	},

	"license": "MIT",

	"authors": [
		{
			"name": "Greg Bowler",
			"email": "greg@g105b.com"
		}
	],

	"autoload": {
		"psr-4": {
			"GT\\Cli\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\Cli\\Test\\": "./test/phpunit"
		}
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src --memory-limit 256M",
		"test": [
			"@phpunit",
			"@phpcs",
			"@phpmd",
			"@phpstan"
		]
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/phpgt"
		}
	],
	"config": {
		"platform": {
			"php": "8.2.0"
		}
	}
}
